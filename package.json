{
  "name": "vidya-pragati-setu",
  "private": true,
  "version": "0.1.0",
  "description": "Vidya Pragati Setu — Student Scholarship & Educational Assistance Information Platform",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "server:dev": "npm --prefix server run dev",
    "server:build": "npm --prefix server run build",
    "server:start": "npm --prefix server run start",
    "server:typecheck": "npm --prefix server run typecheck",
    "fullstack:typecheck": "npm run typecheck && npm run server:typecheck",
    "fullstack:build": "npm run build && npm run server:build"
  },
  "dependencies": {
    "framer-motion": "^11.3.19",
    "lucide-react": "^0.427.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^8.3.5"
  }
}
